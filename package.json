{
  "name": "blizzard.js",
  "version": "5.0.0",
  "keywords": [
    "api",
    "battle.net",
    "battlenet",
    "blizzard",
    "bnet",
    "d3",
    "diablo",
    "hearthstone",
    "hs",
    "sc2",
    "starcraft",
    "warcraft",
    "world of warcraft",
    "wow"
  ],
  "license": "MIT",
  "author": {
    "name": "Ben Weier",
    "email": "ben.weier@gmail.com",
    "url": "https://benweier.dev"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "docs": "typedoc",
    "test": "vp test run",
    "lint": "vp lint",
    "prepack": "npm run build",
    "fmt": "vp fmt",
    "check": "vp check"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@types/node": "^26.2.0",
    "husky": "^8.0.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite-plus": "^0.2.9",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
