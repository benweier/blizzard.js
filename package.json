{
  "name": "blizzard.js",
  "version": "5.0.0",
  "keywords": [
    "api",
    "battle.net",
    "battlenet",
    "blizzard",
    "bnet",
    "d3",
    "diablo",
    "hearthstone",
    "hs",
    "sc2",
    "starcraft",
    "warcraft",
    "world of warcraft",
    "wow"
  ],
  "license": "MIT",
  "author": {
    "name": "Ben Weier",
    "email": "ben.weier@gmail.com",
    "url": "https://benweier.dev"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "lint": "vp lint",
    "prepack": "npm run build",
    "fmt": "vp fmt",
    "check": "vp check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.9",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
